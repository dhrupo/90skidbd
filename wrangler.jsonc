{
  "name": "90skidbd",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/c/*"]
  },
  "kv_namespaces": [
    { "binding": "CARDS", "id": "e97101d14ccb49d6bf276a925cc6ab3c" }
  ],
  "ratelimits": [
    { "name": "UPLOADS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "env": {
    "test": {
      "kv_namespaces": [{ "binding": "CARDS", "id": "test-cards" }],
      "ratelimits": [{ "name": "UPLOADS", "namespace_id": "1002", "simple": { "limit": 1000, "period": 60 } }]
    }
  }
}
